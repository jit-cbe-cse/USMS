# ---------------------------------------------------------------------------
# USMS environment configuration
#
#   cp .env.example .env      then edit .env
#
# .env is git-ignored. NEVER commit real secrets.
# Both `flask` (via python-dotenv) and `docker compose` read this file.
# ---------------------------------------------------------------------------

# --- Flask -----------------------------------------------------------------
FLASK_APP=app.py
# 1 = auto-reload + debugger. Use 0 (or remove) in production.
FLASK_DEBUG=1
# Signs sessions/cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Database --------------------------------------------------------------
# Development (default when unset): SQLite file at instance/usms.db
DATABASE_URL=sqlite:///usms.db

# Production / local MySQL (uncomment and replace the line above):
# DATABASE_URL=mysql+pymysql://usms:usms_password@localhost:3306/usms?charset=utf8mb4

# --- Docker Compose only ---------------------------------------------------
# Used by docker-compose.yml for the MySQL container. The web container builds
# its own DATABASE_URL from MYSQL_PASSWORD, so you don't set DATABASE_URL for Docker.
MYSQL_PASSWORD=usms_password
MYSQL_ROOT_PASSWORD=root_password
